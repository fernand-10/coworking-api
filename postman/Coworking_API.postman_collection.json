                "{{base_url}}"
              ],
              "path": [
                "reservations",
                "pending"
              ]
            }
          }
        },
        {
          "name": "Approve Reservation",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/reservations/2/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "reservations",
                "2",
                "status"
              ]
            }
          }
        },
        {
          "name": "Complete Reservation",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/reservations/1/complete",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "reservations",
                "1",
                "complete"
              ]
            }
          }
        },
        {
          "name": "Daily Occupancy",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/spaces-occupancy",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "spaces-occupancy"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Catalog, Users & Roles",
      "item": [
        {
          "name": "Create Space",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"space_type_id\": 1,\n  \"name\": \"Sala Directorio Norte\",\n  \"floor\": 3,\n  \"capacity\": 14,\n  \"price_per_hour\": 65.0,\n  \"is_active\": true\n}",
              "options": {
                "raw": {
